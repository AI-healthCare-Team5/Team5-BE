# 프로필은 SPRING_PROFILES_ACTIVE로 지정합니다. 지정하지 않으면 local로 실행됩니다.
# SPRING_PROFILES_ACTIVE=local

# --- 로컬(local) ---
# application-local.yml의 기본값은 docker-compose.yml의 로컬 DB와 같습니다.
# 다른 DB를 쓸 때만 아래 환경 변수를 지정합니다. 실제 값은 커밋하지 않습니다.
# DB_URL=jdbc:postgresql://localhost:5432/jinryohanjang
# DB_USERNAME=postgres
# DB_PASSWORD=
# REDIS_HOST=localhost
# REDIS_PORT=6379

# 아래 키는 기본값이 없습니다. 로컬 환경 변수에 실제 값을 지정합니다.
# Bedrock(Claude). 로컬은 aws configure --profile jinryo로 키를 넣고 BEDROCK_PROFILE=jinryo
# BEDROCK_REGION=ap-southeast-2
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_PROFILE=jinryo
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록한 프론트 콜백 주소 (쉼표로 여러 개). 기본값은 로컬 Vite 주소
# KAKAO_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/kakao/callback
# 공공데이터포털 일반 인증키(Decoding). 병원 동기화에 쓰고, 없으면 동기화를 건너뜁니다
# PUBLIC_DATA_API_KEY=
# 로그인 JWT 서명 키(필수): 32바이트 이상을 Base64로 인코딩한 값. 예: openssl rand -base64 32
# JWT_SECRET=
# 건강정보 암호화 키(필수): 32바이트를 Base64로 인코딩한 값. 예: openssl rand -base64 32
# DATA_ENCRYPTION_KEY=

# --- 개발 서버(dev) ---
# EC2의 ~/team5/.env.dev 에 아래 값을 지정합니다. (SPRING_PROFILES_ACTIVE=dev는 배포 시 자동 지정)
# dev 프로필은 DB/Redis 기본값이 없습니다. DB 값이 없으면 서버가 시작되지 않습니다.
# REDIS_HOST가 없으면 서버는 시작되지만 Redis를 처음 호출할 때 실패하므로 반드시 지정합니다.
# DB_URL=jdbc:postgresql://<RDS 엔드포인트>:5432/jinryohanjang
# DB_USERNAME=
# DB_PASSWORD=
# REDIS_HOST=<ElastiCache 엔드포인트>
# REDIS_PORT=6379
# DATA_ENCRYPTION_KEY=
# BEDROCK_REGION=
# BEDROCK_MODEL_ID=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# JWT_SECRET=
# KAKAO_ALLOWED_REDIRECT_URIS=
# PUBLIC_DATA_API_KEY=
