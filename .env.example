# application.yml의 기본값은 docker-compose.yml의 로컬 DB와 같습니다.
# 다른 DB를 쓸 때만 아래 환경 변수를 지정합니다. 실제 값은 커밋하지 않습니다.
# DB_URL=jdbc:postgresql://localhost:5432/jinryohanjang
# DB_USERNAME=postgres
# DB_PASSWORD=
# REDIS_HOST=localhost
# REDIS_PORT=6379

# 아래 키는 기본값이 없습니다. 로컬 환경 변수에 실제 값을 지정합니다.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=
# OPENAI_STT_MODEL=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# 건강정보 암호화 키(필수): 32바이트를 Base64로 인코딩한 값. 예: openssl rand -base64 32
# DATA_ENCRYPTION_KEY=

# --- 개발 서버(dev) ---
# EC2의 ~/team5/.env.dev 에 아래 값을 지정합니다. (SPRING_PROFILES_ACTIVE=dev는 배포 시 자동 지정)
# dev 프로필은 DB/Redis 기본값이 없어서, 값이 없으면 서버가 시작되지 않습니다.
# DB_URL=jdbc:postgresql://<RDS 엔드포인트>:5432/jinryohanjang
# DB_USERNAME=
# DB_PASSWORD=
# REDIS_HOST=<ElastiCache 엔드포인트>
# REDIS_PORT=6379
# DATA_ENCRYPTION_KEY=
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=
# OPENAI_STT_MODEL=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
